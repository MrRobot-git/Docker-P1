# Imagenes
MYSQL_VERSION=8.0
WORDPRESS_IMAGE=bitnami/wordpress:latest

# Base de datos (cambia estos valores)
MYSQL_ROOT_PASSWORD=cambia_root_password
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wordpress_user
MYSQL_PASSWORD=cambia_user_password

# WordPress (administrador inicial)
WORDPRESS_USERNAME=admin
WORDPRESS_PASSWORD=cambia_admin_password
WORDPRESS_EMAIL=admin@example.com
WORDPRESS_BLOG_NAME="Mi WordPress"

# Acceso publico
PUBLIC_HOST=localhost
HTTP_PORT=8081
HTTPS_PORT=8443
PMA_PORT=8082
