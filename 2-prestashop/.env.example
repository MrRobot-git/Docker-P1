# Imagenes (bitnami/prestashop ya no existe en Docker Hub: se usa la oficial)
MYSQL_VERSION=8.0
PRESTASHOP_IMAGE=prestashop/prestashop:8

# Base de datos (cambia estos valores)
MYSQL_ROOT_PASSWORD=cambia_root_password
MYSQL_DATABASE=prestashop_db
MYSQL_USER=prestashop_user
MYSQL_PASSWORD=cambia_user_password

# PrestaShop (administrador inicial)
PS_FOLDER_INSTALL=install-dev
PS_FOLDER_ADMIN=admin-dev
PS_COUNTRY=es
PS_LANGUAGE=es
ADMIN_MAIL=admin@example.com
ADMIN_PASSWD=cambia_admin_password

# Acceso publico
PUBLIC_HOST=localhost
HTTP_PORT=8091
HTTPS_PORT=9443
PMA_PORT=8092
